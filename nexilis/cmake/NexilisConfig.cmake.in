@PACKAGE_INIT@

include(CMakeFindDependencyMacro)

set(NEXILIS_IS_NIX @NEXILIS_IS_NIX@)
set(NEXILIS_IS_LOCAL @NEXILIS_IS_LOCAL@)
set(NEXILIS_IS_CI @NEXILIS_IS_CI@)
set(NEXILIS_USE_SUBMODULES @NEXILIS_USE_SUBMODULES@)
set(NEXILIS_VERSION "@NEXILIS_VERSION@")

if(@USE_SUBMODULES@)
    message(STATUS "Using submodules")
else()
    find_dependency(Boost REQUIRED COMPONENTS json)
endif()

include("${CMAKE_CURRENT_LIST_DIR}/NexilisTargets.cmake")
